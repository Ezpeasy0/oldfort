rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validText(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen;
    }

    function validNames(data) {
      return validText(data.firstName, 50)
        && validText(data.lastName, 50)
        && validText(data.nickname, 30);
    }

    function areFriends(a, b) {
      return exists(/databases/$(database)/documents/friendships/$(a + '_' + b))
        || exists(/databases/$(database)/documents/friendships/$(b + '_' + a));
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'member') == 'admin';
    }

    function isCommunityChat(chatId) {
      return chatId.matches('community_.+')
        && exists(/databases/$(database)/documents/communityRooms/$(chatId));
    }

    function communityRoomOpen(chatId) {
      return get(/databases/$(database)/documents/communityRooms/$(chatId)).data.open == true;
    }

    function isSupportChat(chatId) {
      return chatId.matches('support_[A-Za-z0-9]+');
    }

    function isSupportOwner(chatId) {
      return signedIn() && chatId == 'support_' + request.auth.uid;
    }

    function canUseSupport(chatId) {
      return isSupportChat(chatId) && (isSupportOwner(chatId) || isAdmin());
    }

    function isPrivateChat(chatId) {
      return chatId.matches('p_.*');
    }

    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function validSystemMessage(chatId) {
      let d = request.resource.data;
      let after = getAfter(/databases/$(database)/documents/chats/$(chatId)).data;
      return isSupportChat(chatId)
        && d.keys().hasOnly(['senderId', 'type', 'text', 'createdAt'])
        && d.type == 'system'
        && ((d.text == 'started' && after.status == 'open')
          || (d.text == 'closed' && after.status == 'closed' && isAdmin()));
    }

    function validTextMessage() {
      return request.resource.data.keys().hasOnly(['senderId', 'text', 'createdAt'])
        && validText(request.resource.data.text, 1000);
    }

    function validMediaMessage(chatId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['senderId', 'type', 'mediaPath', 'mediaUrl', 'width', 'height', 'durationMs', 'createdAt'])
        && d.type in ['image', 'audio', 'video']
        && d.mediaPath is string
        && d.mediaPath.matches('chats/' + chatId + '/' + request.auth.uid + '/[^/]+')
        && d.mediaUrl is string
        && d.mediaUrl.size() <= 2048
        && (!('width' in d) || (d.width is int && d.width > 0))
        && (!('height' in d) || (d.height is int && d.height > 0))
        && (!('durationMs' in d) || (d.durationMs is int && d.durationMs > 0 && d.durationMs <= 180000));
    }

    function onlyMyReadChanged() {
      return request.resource.data.get('lastReadAt', {})
        .diff(resource.data.get('lastReadAt', {}))
        .affectedKeys().hasOnly([request.auth.uid]);
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
             'phone', 'firstName', 'lastName', 'nickname', 'role',
             'pdpaVersion', 'pdpaAcceptedAt', 'createdAt', 'updatedAt'])
        && request.resource.data.role == 'member'
        && request.resource.data.phone == request.auth.token.phone_number
        && request.resource.data.pdpaAcceptedAt == request.time
        && validNames(request.resource.data);

      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['firstName', 'lastName', 'nickname', 'phone', 'updatedAt'])
        && request.resource.data.phone == request.auth.token.phone_number
        && validNames(request.resource.data);

      allow delete: if false;

      match /devices/{token} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['platform', 'updatedAt'])
          && request.resource.data.platform == 'android'
          && request.resource.data.updatedAt == request.time;
      }
    }

    match /publicProfiles/{uid} {
      allow get: if signedIn();

      allow create: if isOwner(uid)
        && exists(/databases/$(database)/documents/users/$(uid))
        && request.resource.data.keys().hasOnly(['nickname', 'friendCode', 'updatedAt'])
        && validText(request.resource.data.nickname, 30)
        && getAfter(/databases/$(database)/documents/friendCodes/$(request.resource.data.friendCode)).data.uid == uid;

      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['nickname', 'photoUrl', 'updatedAt'])
        && validText(request.resource.data.nickname, 30)
        && (!('photoUrl' in request.resource.data)
          || (request.resource.data.photoUrl is string
            && request.resource.data.photoUrl.size() <= 2048));

      allow delete: if false;
    }

    match /communityRooms/{roomId} {
      function validRoom(d) {
        return validText(d.name, 30)
          && d.icon in ['cooking', 'dharma', 'pets', 'garden', 'music', 'travel', 'health', 'chat']
          && d.open is bool
          && d.order is int
          && (!('imageUrl' in d) || (d.imageUrl is string && d.imageUrl.size() <= 2048));
      }

      allow read: if signedIn();

      allow create: if isAdmin()
        && roomId.matches('community_[A-Za-z0-9]+')
        && request.resource.data.keys().hasOnly(['name', 'icon', 'open', 'order', 'createdAt'])
        && validRoom(request.resource.data)
        && request.resource.data.createdAt == request.time;

      allow update: if isAdmin()
        && onlyChanged(['name', 'icon', 'open', 'imageUrl'])
        && validRoom(request.resource.data);

      allow delete: if false;
    }

    match /friendCodes/{code} {
      allow get: if signedIn();

      allow create: if signedIn()
        && code.matches('^[A-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.friendCode == code;

      allow update, delete: if false;
    }

    match /friendRequests/{requestId} {
      allow get: if signedIn() && request.auth.uid in requestId.split('_');
      allow list: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);

      allow create: if signedIn()
        && requestId == request.auth.uid + '_' + request.resource.data.to
        && request.resource.data.keys().hasOnly(['from', 'to', 'createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to != request.auth.uid
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/publicProfiles/$(request.resource.data.to))
        && !areFriends(request.auth.uid, request.resource.data.to);

      allow delete: if signedIn() && request.auth.uid in requestId.split('_');
      allow update: if false;
    }

    match /friendships/{pairId} {
      allow get: if signedIn() && request.auth.uid in pairId.split('_');
      allow list: if signedIn() && request.auth.uid in resource.data.memberIds;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['memberIds', 'createdAt'])
        && request.resource.data.memberIds.size() == 2
        && request.resource.data.memberIds[0] < request.resource.data.memberIds[1]
        && pairId == request.resource.data.memberIds[0] + '_' + request.resource.data.memberIds[1]
        && request.resource.data.createdAt == request.time
        && (
          (request.auth.uid == request.resource.data.memberIds[1]
            && exists(/databases/$(database)/documents/friendRequests/$(request.resource.data.memberIds[0] + '_' + request.resource.data.memberIds[1])))
          || (request.auth.uid == request.resource.data.memberIds[0]
            && exists(/databases/$(database)/documents/friendRequests/$(request.resource.data.memberIds[1] + '_' + request.resource.data.memberIds[0])))
        );

      allow delete: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow update: if false;
    }

    match /chats/{chatId} {
      allow get: if signedIn() && (
        isCommunityChat(chatId)
        || canUseSupport(chatId)
        || (isPrivateChat(chatId) && request.auth.uid in chatId.split('_'))
        || (resource != null && request.auth.uid in resource.data.get('memberIds', []))
      );
      allow list: if signedIn() && (
        (resource.data.type == 'support' && isAdmin())
        || request.auth.uid in resource.data.get('memberIds', [])
      );

      allow create: if signedIn() && (
        (canUseSupport(chatId)
          && request.resource.data.keys().hasOnly(['type', 'status', 'createdAt', 'lastMessage', 'lastMessageAt', 'lastSenderId', 'lastReadAt'])
          && request.resource.data.type == 'support'
          && request.resource.data.status == 'open'
          && request.resource.data.lastSenderId == request.auth.uid
          && request.resource.data.lastReadAt.keys().hasOnly([request.auth.uid]))
        || (isCommunityChat(chatId)
          && request.resource.data.keys().hasOnly(['type', 'lastReadAt'])
          && request.resource.data.type == 'community'
          && request.resource.data.lastReadAt.keys().hasOnly([request.auth.uid]))
        || (isPrivateChat(chatId)
          && request.resource.data.keys().hasOnly(['type', 'memberIds', 'createdAt', 'lastReadAt'])
          && request.resource.data.type == 'private'
          && request.resource.data.memberIds.size() == 2
          && request.resource.data.memberIds[0] < request.resource.data.memberIds[1]
          && chatId == 'p_' + request.resource.data.memberIds[0] + '_' + request.resource.data.memberIds[1]
          && request.auth.uid in request.resource.data.memberIds
          && areFriends(request.resource.data.memberIds[0], request.resource.data.memberIds[1])
          && request.resource.data.createdAt == request.time
          && request.resource.data.lastReadAt.size() == 0)
        || (!chatId.matches('community_.*') && !isPrivateChat(chatId) && !isSupportChat(chatId)
          && request.resource.data.keys().hasOnly(['type', 'name', 'ownerId', 'memberIds', 'createdAt', 'lastReadAt'])
          && request.resource.data.type == 'group'
          && request.resource.data.ownerId == request.auth.uid
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.memberIds.size() >= 2
          && request.resource.data.memberIds.size() <= 50
          && validText(request.resource.data.name, 50)
          && request.resource.data.createdAt == request.time
          && request.resource.data.lastReadAt.size() == 0)
      );

      allow update: if signedIn() && (
        (isCommunityChat(chatId) && onlyChanged(['lastReadAt']) && onlyMyReadChanged())
        || (canUseSupport(chatId) && (
          (onlyChanged(['lastReadAt']) && onlyMyReadChanged())
          || (resource.data.status == 'open'
            && onlyChanged(['lastMessage', 'lastMessageAt', 'lastSenderId', 'lastReadAt', 'lastAdminId'])
            && onlyMyReadChanged()
            && request.resource.data.lastSenderId == request.auth.uid
            && request.resource.data.lastMessageAt == request.time
            && request.resource.data.lastMessage is string
            && request.resource.data.lastMessage.size() <= 101
            && (request.resource.data.get('lastAdminId', null) == resource.data.get('lastAdminId', null)
              || (request.resource.data.lastAdminId == request.auth.uid && isAdmin())))
          || (resource.data.status == 'open' && isAdmin()
            && onlyChanged(['status', 'closedBy', 'lastMessage', 'lastMessageAt', 'lastSenderId', 'lastReadAt'])
            && onlyMyReadChanged()
            && request.resource.data.status == 'closed'
            && request.resource.data.closedBy == request.auth.uid
            && request.resource.data.lastSenderId == request.auth.uid
            && request.resource.data.lastMessageAt == request.time)
          || (resource.data.status == 'closed'
            && onlyChanged(['status', 'closedBy', 'lastAdminId', 'lastMessage', 'lastMessageAt', 'lastSenderId', 'lastReadAt'])
            && onlyMyReadChanged()
            && request.resource.data.status == 'open'
            && !('closedBy' in request.resource.data)
            && !('lastAdminId' in request.resource.data)
            && request.resource.data.lastSenderId == request.auth.uid
            && request.resource.data.lastMessageAt == request.time)
        ))
        || (!isCommunityChat(chatId) && !isSupportChat(chatId)
          && request.auth.uid in resource.data.get('memberIds', []) && (
          (onlyChanged(['lastReadAt']) && onlyMyReadChanged())
          || (onlyChanged(['lastMessage', 'lastMessageAt', 'lastSenderId', 'lastReadAt'])
            && onlyMyReadChanged()
            && request.resource.data.lastSenderId == request.auth.uid
            && request.resource.data.lastMessageAt == request.time
            && request.resource.data.lastMessage is string
            && request.resource.data.lastMessage.size() <= 101)
          || (resource.data.type == 'group'
            && resource.data.ownerId == request.auth.uid
            && onlyChanged(['name', 'memberIds', 'photoUrl'])
            && request.auth.uid in request.resource.data.memberIds
            && request.resource.data.memberIds.size() <= 50
            && validText(request.resource.data.name, 50)
            && (!('photoUrl' in request.resource.data)
              || (request.resource.data.photoUrl is string
                && request.resource.data.photoUrl.size() <= 2048)))
          || (resource.data.type == 'group'
            && resource.data.ownerId != request.auth.uid
            && onlyChanged(['memberIds'])
            && request.resource.data.memberIds.toSet()
                 == resource.data.memberIds.toSet().difference([request.auth.uid].toSet()))
        ))
      );

      allow delete: if signedIn()
        && resource.data.type == 'group'
        && resource.data.ownerId == request.auth.uid;

      match /messages/{messageId} {
        function chatDoc() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }

        allow read: if signedIn()
          && (isCommunityChat(chatId)
            || canUseSupport(chatId)
            || request.auth.uid in chatDoc().get('memberIds', []));

        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.createdAt == request.time
          && (
            (canUseSupport(chatId)
              && (validSystemMessage(chatId)
                || ((validTextMessage() || validMediaMessage(chatId))
                  && getAfter(/databases/$(database)/documents/chats/$(chatId)).data.status == 'open')))
            || ((validTextMessage() || validMediaMessage(chatId))
              && isCommunityChat(chatId)
              && communityRoomOpen(chatId))
            || ((validTextMessage() || validMediaMessage(chatId))
              && !isSupportChat(chatId)
              && request.auth.uid in chatDoc().get('memberIds', [])
              && (chatDoc().type == 'group'
                || areFriends(chatDoc().memberIds[0], chatDoc().memberIds[1])))
          );

        allow update, delete: if false;
      }
    }
  }
}