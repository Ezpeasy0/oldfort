rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('role', 'member') == 'admin';
    }

    function isCommunityChat(chatId) {
      return chatId.matches('community_.+')
        && firestore.exists(/databases/(default)/documents/communityRooms/$(chatId));
    }

    function isSupportChat(chatId) {
      return chatId.matches('support_[A-Za-z0-9]+');
    }

    function chatData(chatId) {
      return firestore.get(/databases/(default)/documents/chats/$(chatId)).data;
    }

    function isMember(chatId) {
      return isCommunityChat(chatId)
        || (isSupportChat(chatId) && (chatId == 'support_' + request.auth.uid || isAdmin()))
        || (!isSupportChat(chatId) && request.auth.uid in chatData(chatId).get('memberIds', []));
    }

    function isTypeUnder(type, maxMb) {
      return request.resource.contentType.matches(type + '/.*')
        && request.resource.size < maxMb * 1024 * 1024;
    }

    function isImageUnder(maxMb) {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < maxMb * 1024 * 1024;
    }

    match /chats/{chatId}/{uid}/{fileName} {
      allow read: if signedIn() && isMember(chatId);
      allow create: if signedIn()
        && request.auth.uid == uid
        && isMember(chatId)
        && (isTypeUnder('image', 10) || isTypeUnder('audio', 10) || isTypeUnder('video', 100));
      allow update, delete: if false;
    }

    match /groups/{chatId}/{fileName} {
      allow read: if signedIn() && isMember(chatId);
      allow create: if signedIn()
        && chatData(chatId).ownerId == request.auth.uid
        && isImageUnder(5);
      allow update, delete: if false;
    }

    match /rooms/{roomId}/{fileName} {
      allow read: if signedIn();
      allow create: if signedIn() && isAdmin() && isImageUnder(5);
      allow delete: if signedIn() && isAdmin();
      allow update: if false;
    }

    match /users/{uid}/{fileName} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == uid
        && isImageUnder(5);
      allow delete: if signedIn() && request.auth.uid == uid;
      allow update: if false;
    }
  }
}
